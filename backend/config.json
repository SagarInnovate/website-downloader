{
  "maxDepth": 5,
  "maxPages": 1000,
  "workerCount": 10,
  "requestTimeout": 30,
  "rateLimit": 5,
  "allowedExtensions": [
    ".html",
    ".htm",
    ".css",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".svg",
    ".webp",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".pdf",
    ".json",
    ".xml"
  ],
  "tempDir": "./temp",
  "outputDir": "./downloads",
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
}
